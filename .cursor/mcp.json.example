{
  "mcpServers": {
    "sqlite-history": {
      "command": "/opt/homebrew/bin/uvx",
      "args": [
        "mcp-server-sqlite",
        "--db-path",
        "/Users/ilmaru/trading_bot/history.db"
      ]
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
